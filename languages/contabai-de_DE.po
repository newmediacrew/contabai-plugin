msgstr "Sortieren nach"

msgid ""
"Start generating all location pages? Each page calls OpenAI and can take "
"several minutes."
msgstr ""
"Generierung aller Standortseiten starten? Jede Seite ruft OpenAI auf und "
"kann mehrere Minuten dauern."

msgid "Status"
msgstr "Status"

msgid "Stay must be between %1$d and %2$d nights."
msgstr "Der Aufenthalt muss zwischen %1$d und %2$d Nächten liegen."

