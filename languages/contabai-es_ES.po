msgid "Choose a country from the list."
msgstr "Elige un país de la lista."

msgid "Each field can be at most 255 characters."
msgstr "Cada campo puede tener como máximo 255 caracteres."

msgid "Enter a valid email address."
msgstr "Introduce una dirección de correo electrónico válida."

msgid "Enter your username and password."
msgstr "Introduce tu nombre de usuario y tu contraseña."

msgid "Enter your username."
msgstr "Introduce tu nombre de usuario."

msgid "Please accept the house rules and the terms and conditions."
msgstr "Acepta las normas de la casa y los términos y condiciones."

msgid "Please check the number of guests."
msgstr "Revisa el número de huéspedes."

msgid "Please check your optional extras."
msgstr "Revisa tus extras opcionales."

msgid "Please verify your email address first — check your inbox for the link."
msgstr "Primero verifica tu dirección de correo electrónico: encontrarás el enlace en tu bandeja de entrada."

msgid "Some filters could not be applied. Please adjust them and try again."
msgstr "No se han podido aplicar algunos filtros. Ajústalos y vuelve a intentarlo."

msgid "That nickname is already taken. Choose another one."
msgstr "Ese apodo ya está en uso. Elige otro."

msgid "That username is taken or not allowed. Use letters, numbers, dashes and underscores only."
msgstr "Ese nombre de usuario ya está en uso o no está permitido. Usa solo letras, números, guiones y guiones bajos."

msgid "This host is not available for chat right now."
msgstr "Este anfitrión no está disponible para chatear en este momento."

msgid "This property is no longer available."
msgstr "Este alojamiento ya no está disponible."

msgid "This stay can no longer be booked as chosen — the dates may be taken, too close to today, too far ahead, or outside the allowed number of nights."
msgstr "Esta estancia ya no se puede reservar así: puede que las fechas estén ocupadas, sean demasiado próximas o lejanas, o no cumplan el número de noches permitido."

msgid "Too many attempts. Please wait a minute and try again."
msgstr "Demasiados intentos. Espera un minuto y vuelve a intentarlo."

msgid "Upload a JPG, PNG or WebP image of at most 5 MB."
msgstr "Sube una imagen JPG, PNG o WebP de 5 MB como máximo."

msgid "Use at least 8 characters including a number, avoid known leaked passwords, and type the same password twice."
msgstr "Usa al menos 8 caracteres con un número, evita contraseñas filtradas conocidas y escribe la misma contraseña dos veces."

msgid "Wrong username or password."
msgstr "Nombre de usuario o contraseña incorrectos."

msgid "Your message is empty or longer than 2,000 characters."
msgstr "Tu mensaje está vacío o supera los 2.000 caracteres."

msgid "Your message to the host can be at most 500 characters."
msgstr "Tu mensaje para el anfitrión puede tener como máximo 500 caracteres."

msgid "Your party is larger than this property allows."
msgstr "Tu grupo es más grande de lo que permite este alojamiento."

msgid "Your session has expired. Please log in again."
msgstr "Tu sesión ha caducado. Vuelve a iniciar sesión."

msgid "We could not get a price for these dates. Please try other dates."
msgstr "No hemos podido obtener un precio para estas fechas. Prueba con otras fechas."

msgid "Check-out only"
msgstr "Solo salida"

msgid "You can check out on this day, but not arrive. Pick an earlier arrival date."
msgstr "Este día puedes salir, pero no llegar. Elige una fecha de llegada anterior."

msgid "Some nights in these dates are already booked. Please pick other dates."
msgstr "Algunas noches de estas fechas ya están reservadas. Elige otras fechas."

msgid "(optional) Location keys to preselect in Where when the URL has none (e.g. country=\"cw\" city=\"willemstad\"). The grid shortcode passes its own location on location pages."
msgstr "(opcional) Claves de ubicación que se preseleccionan en Dónde cuando la URL no tiene ninguna (p. ej. country=\"cw\" city=\"willemstad\"). El shortcode de la cuadrícula pasa su propia ubicación en las páginas de ubicación."

msgid "Could not load your bookings."
msgstr "No se pudieron cargar tus reservas."

msgid "Only with pets"
msgstr "Solo con mascotas"

msgid "Metered utilities"
msgstr "Consumos"

msgid "Read at check-out and settled from your deposit."
msgstr "Se lee a la salida y se descuenta de tu fianza."

